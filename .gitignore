# MysticDo — pure static site, no build step
# (dist/, .astro/, out-verify/ 等构建产物规则已随旧骨架移除)

# dependencies
node_modules/

# python bytecode (scripts/ is stdlib-only, but --check runs create these)
__pycache__/
*.pyc

# environment variables
.env
.env.production

# cloudflare wrangler local state & secrets
.wrangler/
.dev.vars

# OS / editor
.DS_Store
.idea/
Thumbs.db

# agent workspace data (session memory & logs — local only)
.workbuddy/

# ── 临时脚本与生成产物（永不提交）──
# 约定：一次性的检查/迁移/审计脚本一律写进 scratch/，不要落在仓库根目录。
# 这些路径已同时写入 .assetsignore，不会进 CDN。
scratch/
_design-check/
logo-drafts/
tmp/
temp/

# ── 备份 / 编辑器 / 归档残留 ──
*.bak
*.bak.*
*.old
*.orig
*.rej
*.tmp
*.log
*.swp
*.swo
*~
desktop.ini
